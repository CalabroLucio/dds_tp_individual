{
  "name": "ai-ticket-it-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de AI Ticket It (Node + Express, persistencia en memoria)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
